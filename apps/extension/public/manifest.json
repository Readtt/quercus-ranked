{
  "manifest_version": 3,
  "name": "Quercus Ranked",
  "version": "0.0.1",
  "description": "Easily view assignment averages and compare performance within your Quercus courses.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Quercus Ranked"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["cookies", "storage", "tabs", "alarms"],
  "host_permissions": ["https://q.utoronto.ca/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}